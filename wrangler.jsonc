{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "japanese-writing-mcp",
  "main": "mcp/src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "workers_dev": true,
  "preview_urls": false,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  "env": {
    "staging": {
      "name": "japanese-writing-mcp-staging"
    },
    "production": {
      "name": "japanese-writing-mcp",
      "vars": {
        "WORKER_ORIGIN": "https://japanese-writing-mcp.sado-igoneri-lp.workers.dev"
      },
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "2255c8472ca446438380cf23543ff8b2"
        },
        {
          "binding": "ALLOWLIST",
          "id": "f6b35011a53d4d42b78906f5744a6222"
        }
      ]
    }
  }
}
