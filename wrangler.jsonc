{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "japanese-writing-mcp",
  "main": "mcp/src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  "env": {
    "staging": {
      "name": "japanese-writing-mcp-staging"
    },
    "production": {
      "name": "japanese-writing-mcp"
    }
  }
}
